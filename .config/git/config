[alias]
	alias = config --get-regexp '^alias\\.'
	lg = log --graph --oneline

[commit]
	gpgSign = true

[core]
	autocrlf = input
	editor = vi

[diff]
	tool = vimdiff

[fetch]
	prune = true

[gpg]
	format = ssh

[init]
	defaultBranch = main

[pull]
	ff = only

[status]
	branch = true
	short = true

[url "git@github.com:"]
	insteadOf = https://github.com/

[user]
	email = namjae.kim@namsic.dev
	name = Namjae Kim
	signingkey = ~/.ssh/namjae_kim_namsic_dev.pub
